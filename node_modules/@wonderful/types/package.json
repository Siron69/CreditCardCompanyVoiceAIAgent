{
  "name": "@wonderful/types",
  "version": "0.1.15",
  "description": "TypeScript type definitions for Wonderful runtime development",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "default": "./dist/langchain.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "wonderful",
    "types",
    "typescript",
    "runtime"
  ],
  "author": "Wonderful",
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@anthropic-ai/vertex-sdk": "^0.14.4",
    "@langchain/anthropic": "^1.2.3",
    "@langchain/core": "^1.1.8",
    "@langchain/google-genai": "^2.0.4",
    "@langchain/openai": "^1.1.3",
    "dts-bundle-generator": "^9.5.1",
    "langchain": "^1.2.3",
    "typescript": "^5.3.3",
    "undici-types": "^7.16.0"
  },
  "publishConfig": {
    "registry": "https://npm.wonderful.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wonderfulcx/wonderful.git",
    "directory": "wonderful-runner-platform/wonderful-types"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "scripts": {
    "build": "tsc && pnpm run copy-wit-types",
    "copy-wit-types": "cp -r src/wit dist/",
    "test": "echo \"No tests yet\" && exit 0",
    "clean": "rm -rf dist"
  }
}