{
	"name": "@wonderful/test",
	"version": "0.1.12",
	"description": "Unit testing framework for Wonderful tools",
	"main": "index.js",
	"types": "dist/wrapper.d.ts",
	"author": "Wonderful Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wonderfulcx/wonderful-registry.git",
		"directory": "hq/wonderful-test"
	},
	"exports": {
		".": {
			"require": "./dist/init.js",
			"import": "./dist/init.js",
			"types": "./dist/wrapper.d.ts"
		}
	},
	"napi": {
		"binaryName": "wonderful-test",
		"targets": [
			"x86_64-apple-darwin",
			"x86_64-unknown-linux-gnu",
			"x86_64-unknown-linux-musl",
			"aarch64-unknown-linux-gnu",
			"aarch64-apple-darwin",
			"aarch64-unknown-linux-musl"
		]
	},
	"scripts": {
		"artifacts": "node ../../node_modules/@napi-rs/cli/dist/cli.js artifacts",
		"build": "node ../../node_modules/@napi-rs/cli/dist/cli.js build --platform --release && npm run build:ts",
		"build:debug": "node ../../node_modules/@napi-rs/cli/dist/cli.js build --platform && npm run build:ts",
		"build:ts": "tsc wrapper.ts --outDir dist --module commonjs --target es2020 --esModuleInterop --skipLibCheck --declaration && cp index.d.ts dist/index.d.ts && node -e \"require('fs').writeFileSync('dist/init.js', \\\"const mod=require('./wrapper.js');module.exports=mod;\\n\\\", 'utf8')\"",
		"prepublishOnly": "node ../../node_modules/@napi-rs/cli/dist/cli.js prepublish -t npm",
		"test": "npm run build:debug && vitest run",
		"test:release": "npm run build && vitest run",
		"test:watch": "vitest",
		"version": "node ../../node_modules/@napi-rs/cli/dist/cli.js version",
		"typecheck": "tsc --noEmit"
	},
	"optionalDependencies": {
		"@wonderful/test-darwin-x64": "0.1.12",
		"@wonderful/test-linux-x64-gnu": "0.1.12",
		"@wonderful/test-linux-x64-musl": "0.1.12",
		"@wonderful/test-linux-arm64-gnu": "0.1.12",
		"@wonderful/test-darwin-arm64": "0.1.12",
		"@wonderful/test-linux-arm64-musl": "0.1.12"
	},
	"dependencies": {
		"@wonderful/types": "^0.1.4"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.5.0",
		"@types/node": "^20.0.0",
		"@vitest/ui": "^1.0.0",
		"@wonderful/test": "^0.1.11",
		"typescript": "^5.3.0",
		"vitest": "^1.6.1"
	},
	"peerDependencies": {
		"vitest": ">=0.34.0 || >=1.0.0"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"keywords": [
		"wonderful",
		"testing",
		"unit-tests",
		"vitest",
		"napi-rs",
		"tools"
	],
	"engines": {
		"node": ">= 18"
	},
	"publishConfig": {
		"registry": "https://npm2.wonderful.ai"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"dist/init.js",
		"dist/wrapper.js",
		"dist/wrapper.d.ts",
		"README.md"
	]
}
